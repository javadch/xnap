{
    "manifest_version": 3,
    "name": "Xnap",
    "description": "Capture and organize tweets with pixel-perfect screenshots, metadata, albums, export/import, and Telegram sharing.",
    "version": "0.2.0",
    "homepage_url": "https://github.com/javadch/xnap",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "unlimitedStorage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "128": "assets/xnap128.png"
    },
    "action": {
        "default_title": "Xnap",
        "default_icon": "assets/xnap128.png"
    },
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://twitter.com/*",
                "https://x.com/*"
            ],
            "js": [
                "lib/html2canvas.min.js",
                "js/content.js"
            ]
        }
    ]
}