{
    "manifest_version": 3,
    "name": "Xnap",
    "version": "0.1.0",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "unlimitedStorage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "128": "icon128.png"
    },
    "action": {
        "default_title": "Open Xnap",
        "default_icon": "icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://twitter.com/*",
                "https://x.com/*"
            ],
            "js": [
                "lib/html2canvas.min.js",
                "content.js"
            ]
        }
    ]
}